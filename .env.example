# Скопируйте этот файл в .env и при необходимости задайте свои значения.
# .env не должен попадать в Git.

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=taskflow

# Для запуска без Docker (локально, база доступна на localhost):
# DATABASE_URL=postgresql+psycopg://taskflow:change_me@localhost:5432/taskflow

# Логирование (все переменные необязательные).
# Уровень: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Формат: text | json
LOG_FORMAT=text
# true включает логирование SQL-запросов SQLAlchemy
LOG_SQL=false
# Путь к файлу для дублирования логов (пусто = только stderr)
LOG_FILE=
